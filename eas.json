{
  "cli": {
    "version": ">= 16.1.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "developmentClient": false
      }
    },
    "preview2": {
      "android": {
        "gradleCommand": ":app:assembleRelease"
      }
    },
    "preview3": {
      "developmentClient": true
    },
    "preview4": {
      "distribution": "internal"
    },
    "development": {
      "android": {
        "gradleCommand": ":app:assembleDebug",
        "buildType": "apk"
      },
      "developmentClient": true
    },
    "debug": {
      "android": {
        "gradleCommand": ":app:assembleDebug",
        "buildType": "apk",
        "developmentClient": true,
        "distribution": "internal"
      }
    },
    "production": {
      "autoIncrement": true
    }
  }
}
